
# LLM generation. For rubric compliance, point this to a vLLM OpenAI-compatible server.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY

# Development fallback if vLLM is unavailable.
# Set USE_LLM_FALLBACK=true only for local development.
USE_LLM_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHROMA_PATH=data/index/chroma
COLLECTION_NAME=egyptian_civil_code
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=legal-rag
MLFLOW_MODEL_NAME=LegalRAGConfig

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

PII_BLOCK=true
MAX_QUESTION_LENGTH=2000
